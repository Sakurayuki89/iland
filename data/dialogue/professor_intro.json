    { "id": "l03", "speaker": "Professor", "en": "Look! A butterfly!", "ko": "봐! 나비야!", "audio": "assets/audio/en/professor_intro_l03.mp3" },
    { "id": "l04", "speaker": "Professor", "en": "Take the net, please.", "ko": "잠자리채를 들어 주렴.", "audio": "assets/audio/en/professor_intro_l04.mp3" },
    { "id": "l05", "speaker": "Professor", "en": "Thank you!", "ko": "고마워!", "audio": "assets/audio/en/professor_intro_l05.mp3" }
  ]
